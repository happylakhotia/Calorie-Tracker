# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Database (Supabase PostgreSQL via Prisma) ─────────────────────────────────
# Transaction-mode pooler (port 6543) — used by the app at runtime (efficient, IPv4 compatible)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler (port 5432) — used by Prisma CLI for migrations (prisma db push / migrate dev)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# ── Supabase Credentials ──────────────────────────────────────────────────────
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ── Redis Cloud (Direct URL) ──────────────────────────────────────────────────
# Found in Redis Cloud Console -> Database -> Configuration -> Public endpoint
# Format: redis://default:[PASSWORD]@[HOST]:[PORT] or rediss:// for TLS
REDIS_URL=redis://default:your_redis_password@your_redis_endpoint.cloud.redislabs.com:12345

# ── Cloudinary (Images & PDFs) ────────────────────────────────────────────────
# Found in Cloudinary Console -> Dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Found in Google AI Studio -> Get API Key
GEMINI_API_KEY=your_gemini_api_key_here

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
